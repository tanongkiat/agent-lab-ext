# file: .env.example
# Copy to .env and fill in. NEVER commit .env — it is gitignored.
#   cp .env.example .env
# On Windows you can generate .env with random secrets instead: .\env-setup.ps1

# --- compose ---
# core=proxy+db+redis+caddy+presidio · data=vector-db+mcp-kb · apps=keycloak+agent-api+expert-mcp
# guard=presidio only · tools=ingest-worker · billing=subscription-service
COMPOSE_PROFILES=core,data,apps
LITELLM_TAG=main-stable

# --- secrets: replace every value. Generate with: openssl rand -hex 16 ---
LITELLM_MASTER_KEY=sk-master-CHANGEME
LITELLM_SALT_KEY=sk-salt-CHANGEME        # must never change once the DB holds data
LITELLM_DB_PASSWORD=CHANGEME
VECTOR_DB_PASSWORD=CHANGEME
CTX_JWT_SECRET=CHANGEME

# --- OpenAI-compatible endpoints (_1, _2, _3, ... add as many as you need) ---
# BASE_URL must end in /v1 · a server on this host uses http://host.docker.internal:<port>/v1
# Endpoints without auth take the literal value: none
# Map each alias to a real model id with tests/pick-models.ps1 (or edit litellm/config.yaml)
OPENAI_COMPATIBLE_1_BASE_URL=https://example.invalid/v1
OPENAI_COMPATIBLE_1_API_KEY=<your-api-key>
OPENAI_COMPATIBLE_1_MODEL=<embedding-model-id>
OPENAI_COMPATIBLE_2_BASE_URL=https://example.invalid/v1
OPENAI_COMPATIBLE_2_API_KEY=<your-api-key>
OPENAI_COMPATIBLE_2_MODEL=<chat-model-id>
OPENAI_COMPATIBLE_3_BASE_URL=https://example.invalid/v1
OPENAI_COMPATIBLE_3_API_KEY=<your-api-key>
OPENAI_COMPATIBLE_3_MODEL=<chat-model-id>
OPENAI_COMPATIBLE_4_BASE_URL=https://example.invalid/v1
OPENAI_COMPATIBLE_4_API_KEY=<your-api-key>
OPENAI_COMPATIBLE_4_MODEL=<fallback-model-id>

# --- Elastic inference, for the elastic-chat model (optional) ---
# Remove the elastic-chat entry from litellm/config.yaml if you do not use it.
ELASTICSEARCH_URL=https://<cluster>.es.<region>.aws.found.io
ES_USER=<elastic-user>
ES_PASS=<elastic-password>

# --- Langfuse tracing, required by litellm_settings.callbacks (optional) ---
# Drop "langfuse" from callbacks in litellm/config.yaml if you do not use it.
LANGFUSE_PUBLIC_KEY=<pk>
LANGFUSE_SECRET_KEY=<sk>
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Keycloak: accepted JWT issuers, comma-separated ---
KC_ISSUERS=http://localhost:8080/realms/lab

# --- subscription-service webhook ---
WEBHOOK_SECRET=CHANGEME

# --- filled in by tests/bootstrap-plans.sh (or .ps1) — leave empty ---
AGENT_KEY_BASIC=
AGENT_KEY_PRO=
EXPERT_KEY=
RETRIEVAL_KEY=
INGEST_KEY=
DEV_KEY_BASIC=
DEV_KEY_PRO=
SUB_ADMIN_KEY=
