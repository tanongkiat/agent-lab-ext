# file: tests/bash/.env.bash.example
# Bash-sourceable mirror of .env, for the tests/bash/*.sh suite.
#
#   cp tests/bash/.env.bash.example tests/bash/.env.bash   # then fill in
#
# NEVER commit .env.bash — it is gitignored. Keep it in sync with .env.
# Values here must match .env exactly; lab.sh prefers .env.bash when present and
# only falls back to parsing .env.

# --- compose ---
export LITELLM_TAG=main-stable
export COMPOSE_PROFILES=core,data,apps

# --- secrets: replace every value. Generate with: openssl rand -hex 16 ---
export LITELLM_MASTER_KEY=sk-master-CHANGEME
export LITELLM_SALT_KEY=sk-salt-CHANGEME      # must never change once the DB holds data
export LITELLM_DB_PASSWORD=CHANGEME
export VECTOR_DB_PASSWORD=CHANGEME
export CTX_JWT_SECRET=CHANGEME

# --- OpenAI-compatible endpoints (_1, _2, _3, ... add as many as you need) ---
# BASE_URL must end in /v1 · a server on the Docker host uses http://host.docker.internal:<port>/v1
# Endpoints without auth take the literal value: none
export OPENAI_COMPATIBLE_1_BASE_URL=https://example.invalid/v1
export OPENAI_COMPATIBLE_1_API_KEY=<your-api-key>
export OPENAI_COMPATIBLE_1_MODEL=<embedding-model-id>
export OPENAI_COMPATIBLE_2_BASE_URL=https://example.invalid/v1
export OPENAI_COMPATIBLE_2_API_KEY=<your-api-key>
export OPENAI_COMPATIBLE_2_MODEL=<chat-model-id>
export OPENAI_COMPATIBLE_3_BASE_URL=https://example.invalid/v1
export OPENAI_COMPATIBLE_3_API_KEY=<your-api-key>
export OPENAI_COMPATIBLE_3_MODEL=<chat-model-id>
export OPENAI_COMPATIBLE_4_BASE_URL=https://example.invalid/v1
export OPENAI_COMPATIBLE_4_API_KEY=<your-api-key>
export OPENAI_COMPATIBLE_4_MODEL=<fallback-model-id>

# --- Elastic inference, for the elastic-chat model (optional) ---
export ELASTICSEARCH_URL=https://<cluster>.es.<region>.aws.found.io
export ES_USER=<elastic-user>
export ES_PASS=<elastic-password>

# --- Langfuse tracing, required by litellm_settings.callbacks (optional) ---
export LANGFUSE_PUBLIC_KEY=<pk>
export LANGFUSE_SECRET_KEY=<sk>
export LANGFUSE_HOST=https://cloud.langfuse.com

# --- Keycloak: accepted JWT issuers, comma-separated ---
# Add every host the tokens may be issued from, e.g. a LAN address of this machine.
export KC_ISSUERS=http://localhost:8080/realms/lab

# --- subscription-service webhook ---
export WEBHOOK_SECRET=CHANGEME

# --- filled in by tests/bash/bootstrap-plans.sh — leave empty ---
export AGENT_KEY_BASIC=
export AGENT_KEY_PRO=
export EXPERT_KEY=
export RETRIEVAL_KEY=
export INGEST_KEY=
export DEV_KEY_BASIC=
export DEV_KEY_PRO=
export SUB_ADMIN_KEY=
